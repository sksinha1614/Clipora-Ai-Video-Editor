
OPENAI_API_KEY=sk-emergent-4375eF2C043A68cE87

# MongoDB Connection
# Local development: mongodb://localhost:27017/clipora
# Production (Emergent deployment): MongoDB Atlas connection string (auto-configured by platform)
MONGO_URL=mongodb://localhost:27017/clipora

# Application Base URL (will be set by deployment platform)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Replicate API Token (for Silero VAD)
# NOTE: You may need to add your own Replicate API token for VAD processing
# Get it from: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your_replicate_token_here

# GROQ API Key (optional, for future use)
GROQ_API_KEY=your_groq_key_here

# CORS Origins (comma-separated, or * for all)
CORS_ORIGINS=*

# Clerk Authentication (optional - runs in keyless mode if not provided)
# Get keys from: https://clerk.com
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
# CLERK_SECRET_KEY=your_clerk_secret_key
